# Copy to .env.e2e in this directory (.env.e2e is gitignored).
# Playwright loads .env.e2e automatically via playwright.config.ts

# Remote Filament admin (optional — leave unset for local Dusk user only)
# PLAYWRIGHT_NO_WEBSERVER=1
# BASE_URL=https://cookies.ypsilon.dev
# E2E_ADMIN_EMAIL=
# E2E_ADMIN_PASSWORD=

# Optional: override example / canary site (default https://duftz.de)
# E2E_EXAMPLE_DOMAIN_URL=https://duftz.de

# Optional external portal tests (e2e/optional-external-portals.spec.ts)
# E2E_EXTERNAL_PORTALS=1
# E2E_COOLIFY_URL=https://coolify.revyome.com/
# E2E_COOLIFY_EMAIL=
# E2E_COOLIFY_PASSWORD=
#
# Coolify REST API (Bearer only — create under Keys & Tokens; not the web password):
# COOLIFY_API_BASE=https://coolify.revyome.com
# COOLIFY_API_TOKEN=3|...
# Then: .\scripts\coolify-applications.ps1 -FilterHost improve.ypsilon.dev
#
# Optional (Improve telemetry app — see .agents/rules/how-to-access-api-ssh-production.md §4):
# COOLIFY_IMPROVE_PROJECT_UUID=...
# COOLIFY_IMPROVE_APP_UUID=j4sdybiem784vj0c9vzwtraj
# E2E_IMPROVE_URL=https://improve.ypsilon.dev/
