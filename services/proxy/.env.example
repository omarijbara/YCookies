# YCookies Proxy Service — Environment Variables
# Copy to .env and fill in values

# Laravel control-plane URL (internal network)
LARAVEL_URL=http://127.0.0.1:8000

# Shared secret for HMAC-SHA256 verification of config responses
# Generate with: openssl rand -hex 32   (must match the Laravel app's PROXY_SHARED_SECRET)
PROXY_SHARED_SECRET=CHANGE_ME

# Port for the proxy service
PROXY_PORT=8080

# Config cache TTL in seconds (5 minutes)
CONFIG_CACHE_TTL=300

# Log level (debug, info, warn, error)
LOG_LEVEL=info

# ── Redis ──────────────────────────────────────────────────────
# Redis connection URL (optional — falls back to in-memory cache if unset)
# REDIS_URL=redis://127.0.0.1:6379

# Enable/disable page-level response caching (default: true)
# CACHE_ENABLED=true

# ── Connection Pool Tuning ─────────────────────────────────────
# Max origin pools to cache (LRU eviction). Default: 200
# POOL_MAX_ENTRIES=200

# Idle pool timeout before cleanup (ms). Default: 300000 (5 min)
# POOL_IDLE_TIMEOUT_MS=300000

# Connections per origin. Default: 10
# For high-traffic single-origin setups, increase to 20-50
# POOL_CONNECTIONS_PER_ORIGIN=10

# Keep-alive timeout (ms). Default: 30000 (30s)
# POOL_KEEP_ALIVE_MS=30000

# Max keep-alive timeout (ms). Default: 60000 (60s)
# POOL_KEEP_ALIVE_MAX_MS=60000

# ── Sentry / GlitchTip Error Tracking ─────────────────────────
# Set DSN to enable structured error reporting
# SENTRY_NODE_DSN=https://your-key@glitchtip.example.com/1

