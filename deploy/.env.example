# YCookies universal Docker stack — environment template
# Copy to .env in this directory and fill in every REQUIRED value:
#   cp .env.example .env

# ── Required ─────────────────────────────────────────────
# Public URL of the admin panel (behind your TLS terminator)
APP_URL=https://cookies.example.com

# Laravel encryption key. Generate with:
#   echo "base64:$(openssl rand -base64 32)"
APP_KEY=

# Database credentials (app user and root MUST differ)
DB_PASSWORD=
DB_ROOT_PASSWORD=

# HMAC secret shared between Laravel and the Node proxy. Generate with:
#   openssl rand -hex 32
PROXY_SHARED_SECRET=

# ── Optional (sensible defaults) ─────────────────────────
# Host ports (put Caddy/Traefik/nginx in front for TLS)
#APP_PORT=8080
#PROXY_PORT=8081

# Database name/user
#DB_DATABASE=ycookies
#DB_USERNAME=ycookies

# Docker Hub namespace + image tag to run
#YCOOKIES_NS=omarijbara
#YCOOKIES_VERSION=latest

# Laravel drivers
#CACHE_STORE=redis
#SESSION_DRIVER=database

# Ed25519 signing key for runtime manifests (optional feature; 32-byte seed).
# Generate with:  openssl rand -hex 32
#RUNTIME_SIGNING_KEY=

# Error tracking (leave empty to disable)
#SENTRY_LARAVEL_DSN=
#SENTRY_NODE_DSN=
#PROXY_LOG_LEVEL=info
