# ══════════════════════════════════════════════════════════════════════════════
# YCookies — Production Environment Variables
# ══════════════════════════════════════════════════════════════════════════════
# Copy this file into your Coolify environment or server .env.
# Variables marked [REQUIRED] must be set before first deploy.
# Variables marked [AUTO] are generated by Coolify magic vars.
# ══════════════════════════════════════════════════════════════════════════════

# ── Laravel Core ──────────────────────────────────────────
APP_NAME=YCookies
APP_ENV=production
APP_DEBUG=false
APP_KEY=                          # [REQUIRED] base64:... — generate with: php artisan key:generate --show
APP_URL=https://cookies.ypsilon.dev

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
BCRYPT_ROUNDS=12

# ── Database (MySQL 8) ───────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=mysql                     # Docker service name
DB_PORT=3306
DB_DATABASE=ycookies
DB_USERNAME=ycookies
DB_PASSWORD=                      # [AUTO] Coolify: SERVICE_PASSWORD_DB

# ── Redis ─────────────────────────────────────────────────
REDIS_CLIENT=phpredis
REDIS_HOST=app-redis              # Docker service name
REDIS_PORT=6379
REDIS_PASSWORD=null

# ── Session / Cache / Queue ──────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=database

# ── Admin Host ────────────────────────────────────────────
ADMIN_HOST=cookies.ypsilon.dev    # Filament admin panel domain

# ── Proxy <-> Laravel HMAC ────────────────────────────────
PROXY_SHARED_SECRET=              # [AUTO] Coolify: SERVICE_BASE64_64_PROXY

# ── Coolify Integration ──────────────────────────────────
COOLIFY_INSTANCE_URL=https://coolify.revyome.com
COOLIFY_API_TOKEN=                # [REQUIRED] API token from Coolify settings
COOLIFY_APP_UUID=                 # [REQUIRED] This app's UUID in Coolify

# ── Error Tracking (GlitchTip / Sentry-compatible) ───────
SENTRY_LARAVEL_DSN=               # [REQUIRED] DSN from GlitchTip project (Laravel)
SENTRY_NODE_DSN=                  # [REQUIRED] DSN from GlitchTip project (Node proxy)
SENTRY_TRACES_SAMPLE_RATE=0.1

GLITCHTIP_URL=http://glitchtip-web:8000
GLITCHTIP_PUBLIC_URL=https://sentry.ypsilon.dev
GLITCHTIP_API_TOKEN=              # [REQUIRED] From GlitchTip > Settings > API Tokens
GLITCHTIP_ORG_SLUG=default

# ── GlitchTip Self-Hosted (Postgres) ─────────────────────
# These are only needed in the docker-compose stack, not in Laravel .env.
# SERVICE_PASSWORD_GLITCHTIPDB=   # [AUTO] Coolify generates this
# SERVICE_PASSWORD_GLITCHTIP=     # [AUTO] Django SECRET_KEY for GlitchTip
# GLITCHTIP_HOST=sentry.ypsilon.dev

# ── Mail (SMTP) ──────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=                        # e.g. smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@ycookies.dev
MAIL_FROM_NAME="${APP_NAME}"

# ── Logging ──────────────────────────────────────────────
# Prefer daily rotation to avoid a single unbounded laravel.log (see config/logging.php).
# LOG_CHANNEL=daily
# LOG_DAILY_DAYS=14
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

# ── Traefik / Proxy Routing ─────────────────────────────
# PROXY_RULE is dynamically managed by CoolifyService::syncDomains().
# Override only if you need a static rule:
# PROXY_RULE=Host(`example.com`) || Host(`www.example.com`)

# ── Node Proxy Tuning (set in docker-compose environment) ─
# POOL_MAX_ENTRIES=200
# POOL_IDLE_TIMEOUT_MS=300000
# POOL_CONNECTIONS_PER_ORIGIN=10
# CACHE_ENABLED=true
# FRESH_TTL=300
# SWR_WINDOW=86400
